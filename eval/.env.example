# Copy this file to .env and fill in real values.
# Never commit .env to git.

# LlamaParse cloud API (https://cloud.llamaindex.ai)
LLAMA_CLOUD_API_KEY=llx-...

# Google Generative AI (Gemini embeddings + generation)
# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...

# Qdrant Cloud (only needed when vector_store.mode = url)
# QDRANT_API_KEY=...
# QDRANT_URL=https://<your-cluster>.qdrant.io
